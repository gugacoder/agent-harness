# -----------------------------------------------------------------------------
# COLETIVOS - CONFIGURACAO UNIFICADA
# -----------------------------------------------------------------------------
# Esquema de portas: prefixo '20'
#   2000-2009: Sources (apps locais)
#   2010-2019: Databases
#   2020-2029: Tools
#   2030-2039: Supabase
#
# Para trocar prefixo, substituir '20' por outro (ex: '30' → 3000-3039)
# REGRA: sem defaults em nenhum lugar. Tudo definido aqui.
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# SOURCES — apps rodando fora do Docker em dev
# Use PREFIX para terminar um prefixo de rota e facilmente escapar de conflitos
# -----------------------------------------------------------------------------
PREFIX=20
PUBLIC_PORT=${PREFIX}00

LANDING_PORT=${PREFIX}01
HUB_PORT=${PREFIX}02
ROTA_PORT=${PREFIX}03
PORTAL_PORT=${PREFIX}04
BACKBONE_PORT=${PREFIX}05

LANDING_HOST=landing.internal
HUB_HOST=hub.internal
ROTA_HOST=rota.internal
PORTAL_HOST=portal.internal
BACKBONE_HOST=backbone.internal

# -----------------------------------------------------------------------------
# HOSTS INTERNOS (comunicacao entre containers Docker)
# -----------------------------------------------------------------------------
# Portas padrao internas (fixas dos containers)
STUDIO_PORT=3000
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
REDIS_PORT=6379
MONGO_PORT=27017
WHISPER_PORT=8000
EVOLUTION_PORT=8080
N8N_PORT=5678

# Hosts internos ao docker (fixas dos containers)
STUDIO_HOST=studio.internal
POSTGRES_HOST=postgres.internal
KONG_HOST=kong.internal
REDIS_HOST=redis.internal
MONGO_HOST=mongo.internal
WHISPER_HOST=whisper.internal
EVOLUTION_HOST=evolution.internal
N8N_HOST=n8n.internal

# Rota para servicos Docker acessarem o backbone (host machine)
BACKBONE_BACKPORT=backbone.internal

# -----------------------------------------------------------------------------
# DOMINIO
# -----------------------------------------------------------------------------
# STAGING: h.app.chega.la
# PRODUCTION: app.chega.la
PUBLIC_DOMAIN=h.app.chega.la
SITE_URL=https://${PUBLIC_DOMAIN}

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# SUPABASE (Self-Hosted)
# -----------------------------------------------------------------------------
SUPABASE_PUBLIC_URL=${SITE_URL}
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT (gerado com npm run generate:keys)
JWT_SECRET=
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# SUPABASE AUTH (GoTrue)
# -----------------------------------------------------------------------------
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

# -----------------------------------------------------------------------------
# EVOLUTION (WhatsApp)
# -----------------------------------------------------------------------------
EVOLUTION_URL=http://${EVOLUTION_HOST}:${EVOLUTION_PORT}
EVOLUTION_INSTANCE=coletivos
EVOLUTION_INSTANCE_NAME=coletivos
EVOLUTION_INSTANCE_TOKEN=evolution-token
EVOLUTION_API_KEY=evolution-key
EVOLUTION_COMMON_PORT=${EVOLUTION_PORT}
BACKBONE_WEBHOOK_URL=http://${BACKBONE_BACKPORT}:${BACKBONE_PORT}/webhook/message-received

# -----------------------------------------------------------------------------
# MONGODB (Audit/Logging)
# -----------------------------------------------------------------------------
MONGO_USER=admin
MONGO_PASSWORD=

# -----------------------------------------------------------------------------
# OPENROUTER
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# WHISPER (Audio Transcription)
# -----------------------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# -----------------------------------------------------------------------------
# N8N (Workflows)
# -----------------------------------------------------------------------------
PUBLIC_N8N_URL=http://localhost:${EXPORT_N8N_PORT}
N8N_ENCRYPTION_KEY=
TIMEZONE=America/Sao_Paulo


# =============================================================================
# -----------------------------------------------------------------------------
# DEV OVERRIDES — COMENTAR EM PRODUCAO
# -----------------------------------------------------------------------------
# Portas e hosts para apps acessarem servicos externamente (fora Docker)

# SOURCES
LANDING_HOST=localhost
HUB_HOST=localhost
ROTA_HOST=localhost
PORTAL_HOST=localhost
BACKBONE_HOST=localhost

# HOSTS INTERNOS
STUDIO_PORT=${PREFIX}32
POSTGRES_PORT=${PREFIX}10
KONG_HTTP_PORT=${PREFIX}30
KONG_HTTPS_PORT=${PREFIX}31
REDIS_PORT=${PREFIX}12
MONGO_PORT=${PREFIX}11
WHISPER_PORT=${PREFIX}25
EVOLUTION_PORT=${PREFIX}22
N8N_PORT=${PREFIX}23

STUDIO_HOST=localhost
POSTGRES_HOST=localhost
KONG_HOST=localhost
REDIS_HOST=localhost
MONGO_HOST=localhost
WHISPER_HOST=localhost
EVOLUTION_HOST=localhost
N8N_HOST=localhost

# Backbone acessivel pelo Docker via host machine
BACKBONE_BACKPORT=host.docker.internal

# URLs locais
PUBLIC_DOMAIN=localhost
SITE_URL=http://localhost:${PUBLIC_PORT}
SUPABASE_PUBLIC_URL=http://localhost:${KONG_HTTP_PORT}
# -----------------------------------------------------------------------------
# =============================================================================
