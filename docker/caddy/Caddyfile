:{$PUBLIC_PORT} {
    # Backbone API
    handle /api/* {
        reverse_proxy {$BACKBONE_HOST}:{$BACKBONE_PORT}
    }

    # Supabase Auth API
    handle /auth/* {
        reverse_proxy kong.internal:8000
    }

    # Supabase REST API (PostgREST)
    handle /rest/* {
        reverse_proxy kong.internal:8000
    }

    # Supabase Storage API
    handle /storage/* {
        reverse_proxy kong.internal:8000
    }

    # Supabase Edge Functions
    handle /functions/* {
        reverse_proxy kong.internal:8000
    }

    # Supabase Realtime (WebSocket)
    handle /realtime/* {
        reverse_proxy kong.internal:8000
    }

    # Central app (Vite PWA)
    handle /central/* {
        reverse_proxy {$CENTRAL_HOST}:{$CENTRAL_PORT}
    }

    # Lojista app (Vite PWA)
    handle /lojista/* {
        reverse_proxy {$LOJISTA_HOST}:{$LOJISTA_PORT}
    }

    # Motoboy app (Vite PWA)
    handle /motoboy/* {
        reverse_proxy {$MOTOBOY_HOST}:{$MOTOBOY_PORT}
    }
}
